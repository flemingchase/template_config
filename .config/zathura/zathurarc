set inputbar-bg "#000000"
set pages-per-row 1
set selection-clipboard clipboard
set adjust-open "best-fit"
set scroll-page-aware "true"
set scroll-full-overlap 0.01
set zoom-min 10
set guioptions ""
set highlight-color "#f48f75"
set highlight-active-color "#6a9fb6"

set render-loading "false"
set scroll-step 50

set synctex "true"
set synctex-editor-command "nvr --remote-silent +%{line} %{input}"

set font 'Fira Mono 20'
set recolor
set statusbar-bg "#000000"
set default-bg "#000000"
set recolor-lightcolor "#000000"
set inputbar-fg "#ffffff"
set statusbar-fg "#ffffff"
set default-fg "#ffffff"
set recolor-darkcolor "#ffffff"
