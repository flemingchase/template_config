#!/usr/bin/env python3
"""Launch PCManFM-Qt with the template's shared native Qt palette."""
import os
import shutil
import sys

binary = shutil.which("pcmanfm-qt")
if binary is None:
    sys.exit("PCManFM-Qt is not installed.")
os.environ["QT_QPA_PLATFORMTHEME"] = "qt6ct"
os.execv(binary, [binary, *sys.argv[1:]])
